# 统一换行符：仓库内一律存 LF，避免 Windows 下 autocrlf 造成的全文件假 diff
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.so binary
*.a binary
*.apk binary
*.jar binary
*.aar binary
*.dex binary
*.keystore binary
*.jks binary
*.ttf binary
*.otf binary
*.mp4 binary
*.m4a binary

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
