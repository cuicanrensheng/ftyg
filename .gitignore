# 备份文件（本项目用 <原名>.bak-<用途>-<日期> / <原名>.bak_<时间戳> 命名，
# 普通 *.bak 规则匹配不到，必须单独列出，否则每次 git add 都会带进几十个备份）
*.bak-*
*.bak_*
*.swp
*~

# Log monitor
log-monitor/node_modules/
log-monitor/dist*/
log-monitor/platform-tools/
log-monitor/vercel/

# Monitor
monitor/node_modules/

# Security tools
security-tools/

# dpt-shell 独立仓库（仅仓库内的 jiagu/dpt/ 工具需要跟踪，见下方 ! 强制）
/dpt-shell/
/dpt-shell/**

# Packaging outputs
dist*/

