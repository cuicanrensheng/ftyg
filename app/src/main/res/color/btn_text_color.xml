<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗按钮文字颜色（退出弹窗等）
  【2026-10-20 橄榄底 + 黄字方案】焦点/按下由蓝 #40A9FF 改为黄 #FFD166，默认白字。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FFFFD166" />
    <item android:state_pressed="true" android:color="#FFFFD166" />
    <item android:color="#FFFFFFFF" />
</selector>
