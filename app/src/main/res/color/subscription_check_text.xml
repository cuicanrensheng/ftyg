<?xml version="1.0" encoding="utf-8"?>
<!-- ✓ 勾选文字颜色：焦点/选中/激活=黄#FFD166；否则全透明(=视觉 gone)
     【2026-10-20 橄榄底 + 黄字方案】原三态蓝 #40A9FF → 黄 #FFD166 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"    android:color="#FFFFD166"/>
    <item android:state_selected="true"   android:color="#FFFFD166"/>
    <item android:state_activated="true"  android:color="#FFFFD166"/>
    <item android:color="#00FFFFFF"/>
</selector>
