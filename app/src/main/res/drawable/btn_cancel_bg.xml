<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗取消/次要按钮背景
  【2026-10-20 橄榄底 + 黄字方案】焦点/按下态由浅蓝 #3340A9FF 改为橄榄暗金底 #3C3525
  + 2dp 白描边 + 8dp 圆角（复用 list_item_focused）；默认按钮底保持 #55576A。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/list_item_focused" />
    <item android:state_pressed="true" android:drawable="@drawable/list_item_focused" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#55576A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
