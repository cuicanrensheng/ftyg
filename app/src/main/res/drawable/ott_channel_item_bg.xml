<?xml version="1.0" encoding="utf-8"?>
<!-- OTT 首页：频道网格卡片。焦点态给高亮边框（大屏遥控焦点必须清晰可辨） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC12406E" />
            <stroke android:width="2dp" android:color="#FF3AA0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC12406E" />
            <stroke android:width="2dp" android:color="#FF3AA0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC12406E" />
            <stroke android:width="2dp" android:color="#FF3AA0FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#660E1E3C" />
            <!-- 【2026-10-13 电视视觉修复】默认态去描边：每卡 1dp 白描边在 4 列网格中
                 上下叠加成「行间横线」，电视上观感突兀。焦点/选中态仍由高亮边框+Selector 呈现。 -->
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>