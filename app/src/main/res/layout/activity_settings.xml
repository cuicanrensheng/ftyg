<?xml version="1.0" encoding="utf-8"?>
<!--
设置页面布局（右侧滑出式菜单风格）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 左侧空白区域（点击关闭） -->
    <View
        android:id="@+id/view_outside"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- 设置面板 -->
    <ScrollView
        android:id="@+id/settings_content"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/panel_bg"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 开机自启 -->
            <LinearLayout
                android:id="@+id/item_boot"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_boot"
                android:nextFocusDown="@+id/item_pip"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/boot_autostart"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_boot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false" />
            </LinearLayout>

            <!-- 换台反转（一级折叠 → 「其他设置」胶囊；视图保留防逻辑 NPE） -->
            <LinearLayout
                android:id="@+id/item_reverse"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_boot"
                android:nextFocusDown="@+id/item_pip"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/channel_reverse"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_reverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false" />
            </LinearLayout>

            <!-- 画中画 -->
            <LinearLayout
                android:id="@+id/item_pip"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_boot"
                android:nextFocusDown="@+id/item_source_mode"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/pip"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_pip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false" />
            </LinearLayout>

            <!-- 源模式 -->
            <LinearLayout
                android:id="@+id/item_source_mode"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_pip"
                android:nextFocusDown="@+id/item_play_group"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/source_mode"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_source_mode_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_mode_live"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 播放设置（分组入口 → 二级胶囊：解码器选择 / 渲染方式 / 屏幕比例） -->
            <LinearLayout
                android:id="@+id/item_play_group"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_source_mode"
                android:nextFocusDown="@+id/item_channel_line"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_play_group"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_group_count"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="@string/settings_group_arrow"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 频道线路选择 【2026-10-18 去重】控制栏已有「线路」按钮 → 本行隐藏（视图保留防逻辑 NPE） -->
            <LinearLayout
                android:id="@+id/item_channel_line"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_play_group"
                android:nextFocusDown="@+id/item_resolution"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/channel_line_select"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_channel_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_source"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 清晰度选择 【2026-10-18 去重】控制栏已有「清晰度」按钮 → 本行隐藏（视图保留防逻辑 NPE） -->
            <LinearLayout
                android:id="@+id/item_resolution"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_channel_line"
                android:nextFocusDown="@+id/item_live_subscribe"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/resolution_select"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_resolution_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 解码器选择（一级折叠 → 「播放设置」胶囊） -->
            <LinearLayout
                android:id="@+id/item_decoder"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_resolution"
                android:nextFocusDown="@+id/item_renderer"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/decoder_select"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_decoder_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 渲染方式（一级折叠 → 「播放设置」胶囊） -->
            <LinearLayout
                android:id="@+id/item_renderer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_decoder"
                android:nextFocusDown="@+id/tv_screen_ratio"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/render_mode"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_renderer_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/surface_view"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 屏幕比例（一级折叠 → 「播放设置」胶囊） -->
            <TextView
                android:id="@+id/tv_screen_ratio"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/screen_ratio"
                android:textColor="@color/setting_item_text_color"
                android:textSize="16sp"
                android:focusable="true"
                android:background="@drawable/item_settings_bg"
                android:nextFocusUp="@+id/item_renderer"
                android:nextFocusDown="@+id/item_redirect"
                android:clickable="true"
                android:layout_marginBottom="8dp"/>


            <!-- HTTP重定向网络配置（一级折叠 → 「其他设置」胶囊） -->
            <LinearLayout
                android:id="@+id/item_redirect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/tv_screen_ratio"
                android:nextFocusDown="@+id/item_live_subscribe"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/http_redirect_config"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_redirect_setting"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>


            <!-- 直播源订阅 -->
            <LinearLayout
                android:id="@+id/item_live_subscribe"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_resolution"
                android:nextFocusDown="@+id/item_epg_subscribe"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_source_subscribe"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 节目单订阅 -->
            <LinearLayout
                android:id="@+id/item_epg_subscribe"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_live_subscribe"
                android:nextFocusDown="@+id/item_exit_dialog"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/epg_subscribe"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 退出弹窗 -->
            <LinearLayout
                android:id="@+id/item_exit_dialog"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_epg_subscribe"
                android:nextFocusDown="@+id/item_extra_group"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/exit_dialog"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_exit_dialog_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/close"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>


            <!-- 其他设置（分组入口 → 二级胶囊：换台反转 / HTTP重定向 / 版本信息） -->
            <LinearLayout
                android:id="@+id/item_extra_group"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_exit_dialog"
                android:nextFocusDown="@+id/item_extra_group"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_extra_group"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_group_count"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="@string/settings_group_arrow"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 版本信息（一级折叠 → 「其他设置」胶囊；视图保留防逻辑 NPE） -->
            <LinearLayout
                android:id="@+id/item_version_info"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_exit_dialog"
                android:nextFocusDown="@+id/item_version_info"
                android:clickable="true"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/version_info"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_version_short"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/version_2_0"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 网页设置提示（地址在代码里按实时局域网 IP 填充） -->
            <TextView
                android:id="@+id/tv_web_settings_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/web_settings_url"
                android:textColor="@color/setting_item_text_color"
                android:textSize="12sp"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
